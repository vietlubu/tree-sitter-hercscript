{
  "grammars": [
    {
      "name": "hercscript",
      "scope": "source.hercscript",
      "file-types": ["hcs", "txt", "hsc"],
      "injection-regex": "^(hercscript|herc)$",
      "path": ".",
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm"
    }
  ],
  "metadata": {
    "version": "0.3.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Hercules Script",
    "authors": [
      {
        "name": "Viet Lubu"
      }
    ],
    "links": {
      "repository": "https://github.com/vietlubu/tree-sitter-hercscript"
    }
  }
}
